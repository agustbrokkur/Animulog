{
  "name": "animulog",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "stop": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3001,5173 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force }\"",
    "stop:cmd": "for /f \"tokens=5\" %a in ('netstat -aon ^| findstr \":3001 :5173\"') do taskkill /F /PID %a",
    "dev:frontend": "npm run dev -w animulog-frontend",
    "dev:server": "npm run dev -w animulog-server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14"
  }
}
